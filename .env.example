# Discord Developer Portalで発行したBotトークン（このファイルには実値を書かない）
DISCORD_TOKEN=

# 管理対象のDiscordサーバーID。単一サーバー境界を明示するため設定を推奨
DISCORD_GUILD_ID=

# 任意: 個別サーバーだけで使う固定卓。未設定なら固定卓を追加しない。
# room_idとnameは導入後に変更しないこと（DB復元・既存カテゴリ再利用のキーになる）。
# allowed_gm_user_idsはGM取得許可、access_role_namesは参加資格。
# sync_permissionsはカテゴリ・#参加受付・VCの平常時権限同期。通常は省略時true。
# このBotの「ねいとくん村」だけは既存手動構成を守るため省略時もfalse扱い。
# falseではこの3つをDiscordで事前作成・手動設定し、不足時は起動を中止する。
# #昼/#霊界はカテゴリの手動閲覧設定を複製して作成し、生死に応じた個別権限と
# ゲーム中VCのspeak/send_messagesだけは秘密保持のため一時的にBotが管理する。
# VCは終了時に開始前の値へ戻し、Bot所有IDのない同名チャンネルは削除しない。
# rated=false の卓はレート・統計の対象外。省略時はtrueだが、このBotの
# 「ねいとくん村」は省略時もfalse扱い。募集はGM名前村の #参加受付 へ統合済みで、
# 旧 recruitment_enabled キーだけは既存.envとの互換のため型を検証して無視する。
# WEREWOLF_LOCAL_ROOMS_JSON='[{"room_id":"community","name":"コミュニティ村","allowed_gm_user_ids":[123456789012345678],"access_role_names":["コミュニティ参加者"],"sync_permissions":false}]'
# 運用開始後は次も1にすると、上の設定が欠落・破損した際に起動を安全側で中止する。
# WEREWOLF_LOCAL_ROOMS_REQUIRED=1

# 任意: Administratorを付けずに運営メニューを任せるロール名 (カンマ区切り)。
# #運営 の閲覧・発言権限はDiscord側で手動設定する。この値は閲覧overwriteを
# 変更せず、ボタン操作の認可だけに使う。未設定ならAdministratorと所有者だけ。
# WEREWOLF_OPERATIONS_STAFF_ROLES=運営,モデレーター

# 任意: ロールを使わず名指しで運営メニューを任せるDiscordユーザーID
# (カンマ区切り)。上のロール指定と併用でき、閲覧overwriteは変更しない。
# 数字以外が入っていると起動時に中止する (設定ミスを黙って無権限にしないため)。
# WEREWOLF_OPERATIONS_STAFF_USER_IDS=268251382098690049

# 任意: 同村拒否・報告を1件ずつ残す #運営記録 の閲覧ロール名 (カンマ区切り)。
# #運営 はボタンだけの操作盤に保ち、読み返す記録はこちらへ分ける。
# 開発カテゴリに #運営記録 が無い場合だけ、このロールと Bot だけが読める形で
# Botが作成する (書き込みはBotのみ)。未設定・同名ロールが複数ある場合は作らず、
# 記録は従来どおり #運営 へ流す。既存の #運営記録 があるときは Discord 側の
# 手動設定を正本とし、Botは自分の必要権限だけを補う。
# WEREWOLF_OPERATIONS_LOG_ROLES=運営

# 新規導入先に同名カテゴリが既にあり、このBotの管理下へ明示的に引き継ぐ場合だけ1。
# 保存済みチャンネルIDがある既存運用では不要。判断できない場合は設定しない。
# ADOPT_EXISTING_LAYOUT=1

# 必要な場合だけ変更。通常はOSのユーザー別一時ディレクトリを使用
# WEREWOLF_BOT_RUNTIME_DIR=/absolute/path/to/runtime
